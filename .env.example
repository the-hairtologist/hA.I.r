# ===============================================
# hA.I.r Environment Configuration
# ===============================================
# This file documents all environment variables needed for the application.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!
#
# See CONTRIBUTING.md for security guidelines.
# ===============================================

# -----------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------
# These values are required for the application to function.
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/YOUR_PROJECT/settings/api
#
# SECURITY: These are public keys safe to use in client-side code.
# The anon key is rate-limited and has Row Level Security (RLS) enabled.

# Supabase API URL - Your project's API endpoint
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon/Public Key - Used for client-side authentication
# This is safe to expose in client-side code
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY_HERE

# Supabase Project ID - Your project identifier
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# -----------------------------------------------
# Analytics & Monitoring (OPTIONAL)
# -----------------------------------------------

# Google Analytics 4 Measurement ID
# Get this from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
# Used for: User behavior analytics, traffic monitoring
VITE_GA4_MEASUREMENT_ID=

# Sentry Error Monitoring DSN
# Get this from: https://sentry.io/settings/projects/YOUR_PROJECT/keys/
# Format: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# Used for: Error tracking, performance monitoring, release tracking
VITE_SENTRY_DSN=

# -----------------------------------------------
# CI/CD Secrets (GitHub Actions Only)
# -----------------------------------------------
# These are configured in GitHub repository secrets, NOT in .env files.
# Go to: Settings > Secrets and variables > Actions
#
# Required for CI/CD workflows:
# - CODECOV_TOKEN: For uploading code coverage to Codecov.io
# - GITHUB_TOKEN: Automatically provided by GitHub Actions
#
# Never add these to .env or commit them!

# -----------------------------------------------
# Development Notes
# -----------------------------------------------
# 
# Client-Side Variables:
# - All VITE_* variables are bundled into the client-side code
# - They are publicly visible in the browser
# - Only use VITE_* prefix for non-sensitive configuration
#
# Sensitive Secrets (Server-Side Only):
# - Never use VITE_* prefix for sensitive data
# - Store in Supabase Edge Functions environment variables
# - Access via server-side code only
#
# Examples of what NOT to expose:
# - Database passwords
# - Service account keys  
# - API keys for paid services (Stripe secret key, etc.)
# - OAuth client secrets
# - Encryption keys
#
# For local development:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. Never commit .env to git (.gitignore prevents this)
#
# For production deployment:
# - Set environment variables in your hosting platform
# - Vercel: Settings > Environment Variables
# - Netlify: Site settings > Build & deploy > Environment
# - GitHub Actions: Repository Settings > Secrets
#
# -----------------------------------------------