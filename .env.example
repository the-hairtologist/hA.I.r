# Supabase Configuration (Auto-configured by Lovable Cloud)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_ANON_KEY_HERE
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Google Analytics 4 (Optional - add your measurement ID)
# Get this from https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Sentry Error Monitoring (Optional)
VITE_SENTRY_DSN=

# Other Services (Optional - configured via integrations)
# These are managed via Lovable secrets, not .env