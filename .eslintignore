# CRITICAL: Prevent GitHub workflow permission errors
# Must exclude .github/workflows/ with multiple patterns for safety
.github/workflows
.github/workflows/
.github/workflows/**
.github/workflows/*.yml
.github/workflows/*.yaml

# Build outputs
node_modules
dist
build
coverage
*.tsbuildinfo

# Capacitor
android
ios
dev-dist

# Generated files
src/integrations/supabase/types.ts

# Config files (no linting needed)
*.config.js
*.config.ts
*.config.mjs
*.config.cjs
postcss.config.js
vite.config.ts
tailwind.config.ts

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Environment
.env
.env.*
