{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "ignoreDeprecations": "5.0",
    "noImplicitAny": true,
    "noUnusedParameters": false,
    "skipLibCheck": false,
    "allowJs": false,
    "noUnusedLocals": false,
    "strictNullChecks": true
  }
}
